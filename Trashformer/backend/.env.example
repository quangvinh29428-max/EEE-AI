# Trashformer Backend Environment Configurations
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# AI Model Configuration
# Choose: "demo" (mocked transparently for testing), "yolo" (local weights), or "roboflow" (Roboflow Inference API)
AI_ENGINE_MODE=demo

# Roboflow Config (when AI_ENGINE_MODE=roboflow)
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ENDPOINT=waste-detection-dataset/1

# YOLO Local Model Config (when AI_ENGINE_MODE=yolo)
YOLO_MODEL_PATH=./ai/weights/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

# Google Gemini AI Config (Multimodal Vision & Environmental Chatbot)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database URL (Default: SQLite local database)
DATABASE_URL=sqlite:///./database/trashformer.db

# Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

